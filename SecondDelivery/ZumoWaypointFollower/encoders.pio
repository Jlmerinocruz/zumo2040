; Contador de cuadratura para los encoders del Zumo 2040.
; Es el mismo programa que usa Pololu en su librería de MicroPython
; (zumo-2040-robot/micropython_demo/.../pio_quadrature_counter.py), tomado de
; pico-examples (quadrature_encoder.pio, Copyright (c) 2021 pmarques-dev, BSD-3).
; Lleva la cuenta en Y; al escribir cualquier valor distinto de 0 en el FIFO de
; salida, la máquina de estados regresa la cuenta en el FIFO de entrada.
; Los primeros 16 lugares son una tabla de saltos (estado anterior:actual de los
; canales A y B), así que el programa tiene que cargarse en la dirección 0.

.program quadrature_counter
.origin 0
    jmp update      ; 00 -> 00
    jmp decrement   ; 00 -> 01
    jmp increment   ; 00 -> 10
    jmp update      ; 00 -> 11
    jmp increment   ; 01 -> 00
    jmp update      ; 01 -> 01
    jmp update      ; 01 -> 10
    jmp decrement   ; 01 -> 11
    jmp decrement   ; 10 -> 00
    jmp update      ; 10 -> 01
    jmp update      ; 10 -> 10
    jmp increment   ; 10 -> 11
    jmp update      ; 11 -> 00
    jmp increment   ; 11 -> 01
decrement:          ; 11 -> 10
    jmp y-- update
update:             ; 11 -> 11
.wrap_target
    set x, 0
    pull noblock    ; sin petición, OSR = X = 0
    mov x, osr
    mov osr, isr    ; OSR = canales anteriores
    jmp !x sample_pins
    mov isr, y      ; petición: regresar la cuenta
    push
sample_pins:
    mov isr, null
    in osr, 2
    in pins, 2
    mov pc, isr     ; salta a la tabla con anterior:actual
increment:
    mov x, ~y
    jmp x-- increment2
increment2:
    mov y, ~x
.wrap

% c-sdk {
static inline void quadrature_counter_program_init(PIO pio, uint sm, uint pin_a) {
    pio_sm_set_consecutive_pindirs(pio, sm, pin_a, 2, false);
    gpio_pull_up(pin_a);
    gpio_pull_up(pin_a + 1);
    pio_sm_config c = quadrature_counter_program_get_default_config(0);
    sm_config_set_in_pins(&c, pin_a);
    sm_config_set_in_shift(&c, false, false, 32);   // a la izquierda: ISR = anterior:actual
    pio_sm_init(pio, sm, 0, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
